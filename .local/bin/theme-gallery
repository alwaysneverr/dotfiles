#!/usr/bin/env python3
"""theme-gallery: write ~/.docs/gallery.md comparing every theme in ~/.config/themes.
Re-run after adding a theme. Per theme it uses (all optional):
  ~/.config/themes/<id>/wallpaper.jpg           wallpaper preview
  ~/Pictures/readme/lock-<id>.png               lock screen screenshot
  ~/Pictures/readme/lock-bg-<id>.webp           lock loop (made from lock.mp4 if missing and ffmpeg exists)
  ~/Pictures/readme/grub-<id>.png               GRUB screenshot
  ~/Pictures/readme/plymouth-<id>.gif           boot splash
and writes ~/Pictures/readme/palette-<id>.svg (colour swatches).
Series name: `source = ...` in [meta], else the parentheses in theme.ini's first comment line."""
import configparser, os, re, shutil, subprocess
from pathlib import Path

H = Path.home(); T = H / ".config/themes"; P = H / "Pictures/readme"; OUT = H / ".docs/gallery.md"
P.mkdir(parents=True, exist_ok=True)
cur = os.path.basename(os.path.realpath(T / "current"))
SW = ("bg", "surface_hi", "text", "accent", "secondary", "alert", "good")

def swatch(tid, c):
    w = 40
    rects = "".join(f'<rect x="{i*w}" width="{w}" height="40" fill="{c.get(k, "#888")}"/>' for i, k in enumerate(SW))
    (P / f"palette-{tid}.svg").write_text(
        f'<svg xmlns="http://www.w3.org/2000/svg" width="{w*len(SW)}" height="40" viewBox="0 0 {w*len(SW)} 40">'
        f'<g>{rects}</g></svg>\n')

def img(path, alt, width=None):
    if not path.exists(): return "—"
    rel = os.path.relpath(path, OUT.parent)
    return f'<img src="{rel}" alt="{alt}" width="{width}">' if width else f"![{alt}]({rel})"

themes = []
for d in sorted(T.iterdir()):
    ini = d / "theme.ini"
    if d.name in ("current", "_base") or d.is_symlink() or not ini.is_file(): continue
    cp = configparser.RawConfigParser(delimiters=("=",)); cp.read(ini, encoding="utf-8")
    meta = cp["meta"]; c = dict(cp["colors"]); lock = cp["lock"] if cp.has_section("lock") else {}
    first = ini.read_text(encoding="utf-8").splitlines()[0]
    m = re.search(r"\(([^)]+)\)", first)
    src = meta.get("source") or (m.group(1) if m else "")
    boot = meta.get("boot", "yes").strip().lower() not in ("no", "false", "0")
    wall = "video" if (d / "wallpaper.mp4").exists() else "GIF" if (d / "wallpaper.gif").exists() else "still"
    lockkind = "video loop" if (d / "lock.mp4").exists() else "still image"
    loop = P / f"lock-bg-{d.name}.webp"
    if not loop.exists() and (d / "lock.mp4").exists() and shutil.which("ffmpeg"):
        subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(d / "lock.mp4"), "-vf", "fps=12,scale=640:360:flags=lanczos",
                        "-c:v", "libwebp", "-q:v", "60", "-loop", "0", "-an", str(loop)], check=False)
    swatch(d.name, c)
    themes.append(dict(id=d.name, name=meta.get("name", d.name), src=src, boot=boot, wall=wall, lock=lockkind,
                       accent=c.get("accent", ""), tagline=lock.get("tagline", ""), dir=d))

L = ["[← README](../README.md)", "", "# Theme gallery", "",
     "Every theme side by side. Generated by `theme-gallery` from each theme's `theme.ini`; re-run it after adding a theme.", "",
     "| Theme | From | Accent | Wallpaper | Lock background | Boot visuals |",
     "|-------|------|--------|-----------|-----------------|--------------|"]
for t in themes:
    star = " (active)" if t["id"] == cur else ""
    L.append(f'| [{t["name"]}](#{t["id"]}){star} | {t["src"] or "—"} | `{t["accent"]}` | {t["wall"]} | {t["lock"]} | {"GRUB, Plymouth, tuigreet" if t["boot"] else "—"} |')
for t in themes:
    d = t["dir"]; i = t["id"]
    L += ["", f'<a id="{i}"></a>', "", f'## {t["name"]}', ""]
    if t["tagline"]: L += [f'> {t["tagline"]}', ""]
    # one picture per row: GitHub shrinks images that share a table row
    L += [img(P / f"palette-{i}.svg", f'{t["name"]} palette', 280), ""]
    shots = [("Wallpaper", d / "wallpaper.jpg"), ("Lock screen", P / f"lock-{i}.png"),
             ("Lock background", next((x for x in (P / f"lock-bg-{i}.webp", d / "lock.jpg", d / "lock.png") if x.exists()), P / f"lock-bg-{i}.webp")), ("Emblem", d / "logo.png")]
    if t["boot"]:
        shots += [("Boot menu (GRUB)", P / f"grub-{i}.png"), ("Boot splash (Plymouth)", P / f"plymouth-{i}.gif")]
    for label, path in shots:
        L += [f"**{label}**", "", img(path, f'{t["name"]} {label.lower()}', 160 if label == "Emblem" else None), ""]
OUT.write_text("\n".join(L).rstrip() + "\n", encoding="utf-8")
print(f"theme-gallery: {len(themes)} themes -> {OUT}")
