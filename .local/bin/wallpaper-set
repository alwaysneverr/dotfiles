#!/bin/sh
# wallpaper-set [FILE]   set the wallpaper through awww (formerly swww), with a transition.
# No FILE: the current theme's wallpaper.gif (animated) if present, else wallpaper.jpg.
# Tweak with WALL_TRANSITION (grow, wipe, wave, outer, fade, random, none...),
# WALL_POS (center, top-left, 0.5,0.5...) and WALL_DURATION (seconds).
T="$HOME/.config/themes/current"
f=$1
if [ -z "$f" ]; then
  # ~/.config/themes/.still (set by wallpaper-anim) keeps animated wallpapers still
  anim="$T/wallpaper.gif"; [ -e "$HOME/.config/themes/.still" ] && anim=""
  for c in $anim "$T/wallpaper.jpg" "$T/wallpaper.png"; do
    [ -f "$c" ] && { f=$c; break; }
  done
fi
[ -f "$f" ] || { echo "wallpaper-set: no wallpaper found" >&2; exit 1; }

A=awww; command -v awww >/dev/null 2>&1 || A=swww
if ! "$A" query >/dev/null 2>&1; then
  uwsm app -t service -- "$A-daemon" >/dev/null 2>&1 || "$A-daemon" >/dev/null 2>&1 &
  i=0; until "$A" query >/dev/null 2>&1 || [ $i -ge 50 ]; do sleep 0.1; i=$((i + 1)); done
fi
exec "$A" img "$f" --resize crop \
  --transition-type "${WALL_TRANSITION:-grow}" --transition-pos "${WALL_POS:-center}" \
  --transition-duration "${WALL_DURATION:-1.2}" --transition-fps 60
