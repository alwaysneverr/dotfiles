#!/usr/bin/env python3
"""theme-gen NAME - write every app's colour file for a theme into ~/.config/themes/NAME/gen/,
set up its qylock lock theme, and update the theme-dependent values in the Waybar config."""
import configparser, os, re, sys, pathlib

HOME = pathlib.Path.home()
THEMES = HOME / ".config/themes"
QYLOCK = HOME / ".local/share/qylock-themes"

def load(name):
    p = THEMES / name / "theme.ini"
    if not p.is_file():
        sys.exit(f"theme-gen: no theme '{name}' ({p} missing)")
    cp = configparser.RawConfigParser(delimiters=("=",))
    cp.read(p, encoding="utf-8")
    return cp

def h(c):            # "#rrggbb" -> "rrggbb"
    return c.strip().lstrip("#").lower()

def rgb(c):          # "#rrggbb" -> "r, g, b"
    c = h(c); return ", ".join(str(int(c[i:i+2], 16)) for i in (0, 2, 4))

def gen(name):
    t = load(name); c = t["colors"]; a = t["ansi"]; L = t["lock"]; m = t["meta"]
    out = THEMES / name / "gen"; out.mkdir(parents=True, exist_ok=True)
    w = lambda f, s: (out / f).write_text(s, encoding="utf-8")

    w("kitty.conf", f"""# generated by theme-gen ({m['name']})
background            {c['bg']}
foreground            {c['text']}
selection_background  {c['alert']}
selection_foreground  {c['bg']}
url_color             {c['accent']}
cursor                {c['accent']}
cursor_text_color     {c['bg']}
active_border_color   {c['alert']}
inactive_border_color {c['surface']}
""" + "".join(f"color{i:<2} {a[f'color{i}']}\n" for i in range(16)))

    w("waybar.css", f"""/* generated by theme-gen ({m['name']}) */
@define-color bg_dark     rgba({rgb(c['bg'])}, 0.75);
@define-color bg_capsule  rgba({rgb(c['surface'])}, 0.5);
@define-color bg_alt      {c['bg_alt']};
@define-color alert       {c['alert']};
@define-color accent      {c['accent']};
@define-color secondary   {c['secondary']};
@define-color text_main   {c['text']};
@define-color text_bright {c['text_bright']};
@define-color text_dim    {c['text_dim']};
@define-color good        {c['good']};
""")

    w("dunst.conf", f"""# generated by theme-gen ({m['name']})
[urgency_low]
    background = "{c['bg_alt']}D9"
    foreground = "{c['secondary']}"
    frame_color = "{c['surface']}"

[urgency_normal]
    background = "{c['bg_alt']}D9"
    foreground = "{c['text_bright']}"
    frame_color = "{c['accent']}"
    highlight = "{c['accent']}"

[urgency_critical]
    background = "{c['bg_alt']}E6"
    foreground = "{c['text_bright']}"
    frame_color = "{c['alert']}"
    highlight = "{c['alert']}"
""")

    w("fuzzel.ini", f"""# generated by theme-gen ({m['name']})
[colors]
background={h(c['bg_alt'])}e6
text={h(c['text'])}ff
prompt={h(c['accent'])}ff
input={h(c['text'])}ff
match={h(c['accent'])}ff
selection={h(c['accent'])}ff
selection-text={h(c['bg_alt'])}ff
selection-match={h(c['bg_alt'])}ff
border={h(c['accent'])}ff
""")

    w("hyprlock.conf", f"""# generated by theme-gen ({m['name']})
$bg = rgba({h(c['bg'])}ff)
$inner = rgba({h(c['bg'])}bf)
$accent = rgba({h(c['accent'])}ff)
$secondary = rgba({h(c['secondary'])}ff)
$secondary80 = rgba({h(c['secondary'])}cc)
$text = rgba({h(c['text'])}ff)
$text90 = rgba({h(c['text'])}e6)
$alert = rgba({h(c['alert'])}ff)
$placeholder = {L['tagline']}
$failtext = {L['failtext']}
""")

    w("hyprland.lua", f"""-- generated by theme-gen ({m['name']})
return {{
    border_a        = "rgba({h(c['border_a'])}ee)",
    border_b        = "rgba({h(c['border_b'])}ee)",
    border_inactive = "rgba({h(c['surface'])}ee)",
    background      = "0x{h(c['bg'])}",
}}
""")

    w("gtk.css", f"""/* generated by theme-gen ({m['name']}) */
@define-color accent_color {c['accent']};
@define-color accent_bg_color {c['accent']};
@define-color accent_fg_color {c['bg_alt']};
@define-color window_bg_color {c['bg_alt']};
@define-color window_fg_color {c['text']};
@define-color view_bg_color {c['view']};
@define-color view_fg_color {c['text']};
@define-color headerbar_bg_color {c['bg_alt']};
@define-color headerbar_fg_color {c['text']};
@define-color sidebar_bg_color {c['view']};
@define-color card_bg_color {c['card']};
@define-color popover_bg_color {c['card']};
@define-color dialog_bg_color {c['view']};
""")

    w("hyprtoolkit.conf", f"""# generated by theme-gen ({m['name']})
font_family = JetBrainsMono Nerd Font
font_size = 16
rounding_large = 12
rounding_small = 6
background = 0xD9{h(c['bg_alt'])}
base = 0xD9{h(c['bg_alt'])}
alternate_base = 0x33{h(c['accent'])}
text = 0xFF{h(c['secondary'])}
bright_text = 0xFF{h(c['text_bright'])}
border = 0xFF{h(c['accent'])}
accent = 0xFF{h(c['alert'])}
accent_secondary = 0xFF{h(c['accent'])}
""")

    bg, view, card, btn = rgb(c['bg_alt']), rgb(c['view']), rgb(c['card']), rgb(c['surface'])
    fg, dim, acc, sec, red, good = rgb(c['text']), rgb(c['text_dim']), rgb(c['accent']), rgb(c['secondary']), rgb(c['alert']), rgb(c['good'])
    def sec_(n, b, ba, f=fg, act=acc, ina=dim, link=sec, neu=acc, pos=good, vis=sec):
        return (f"[Colors:{n}]\nBackgroundAlternate={ba}\nBackgroundNormal={b}\nDecorationFocus={acc}\nDecorationHover={acc}\n"
                f"ForegroundActive={act}\nForegroundInactive={ina}\nForegroundLink={link}\nForegroundNegative={red}\n"
                f"ForegroundNeutral={neu}\nForegroundNormal={f}\nForegroundPositive={pos}\nForegroundVisited={vis}\n\n")
    qt = (sec_("Button", btn, card) + sec_("Complementary", bg, card) + sec_("Header", bg, card) + sec_("Tooltip", card, btn)
          + sec_("View", view, card) + sec_("Window", bg, card) + sec_("Selection", acc, acc, bg, bg, bg, bg, bg, bg, bg)
          + f"[General]\nColorScheme={m['name']}\nName={m['name']}\nshadeSortColumn=true\n\n[KDE]\ncontrast=4\n\n"
          + f"[WM]\nactiveBackground={bg}\nactiveForeground={fg}\ninactiveBackground={bg}\ninactiveForeground={dim}\n")
    w("qt.colors", qt)

    w("prompt.sh", f"""# generated by theme-gen ({m['name']}) - sourced by the bash/zsh prompt
THEME_DIM='{c.get('prompt_dim', a['color8'])}'
THEME_USER='{c['border_b']}'
THEME_AT='{c['secondary']}'
THEME_PATH='{c['secondary']}'
THEME_ARROW='{c['border_a']}'
""")

    # qylock lock theme folder: shared layout + this theme's video, logo and settings
    q = QYLOCK / name; q.mkdir(parents=True, exist_ok=True)
    td = THEMES / name
    # lock background: lock.mp4 (video), else lock.jpg/lock.png, else the wallpaper (still image)
    if (td / "lock.mp4").exists():
        media, kind = ("bg.mp4", td / "lock.mp4"), "video"
    else:
        img = next((td / f for f in ("lock.jpg", "lock.png", "wallpaper.jpg", "wallpaper.png") if (td / f).exists()), td / "wallpaper.jpg")
        media, kind = ("bg.jpg", img), "image"
    for stale in ("bg.mp4", "bg.jpg"):
        if stale != media[0] and (q / stale).is_symlink():
            (q / stale).unlink()
    # lock_layout in [lock]: "wuwa" (default, _shared/Main.qml) or another layout in _shared/<name>.qml
    lay = load(name)["lock"].get("lock_layout", "wuwa").strip() if load(name).has_section("lock") else "wuwa"
    main = QYLOCK / "_shared/Main.qml" if lay == "wuwa" else QYLOCK / f"_shared/{lay}.qml"
    links = {"Main.qml": main, "font": QYLOCK / "_shared/font",
             media[0]: media[1], "logo.png": td / "logo.png"}
    if (td / "lock-backdrop.jpg").exists():
        links["backdrop.jpg"] = td / "lock-backdrop.jpg"
    elif (q / "backdrop.jpg").is_symlink():
        (q / "backdrop.jpg").unlink()
    for f, target in links.items():
        p = q / f
        if p.is_symlink() or p.exists():
            if p.is_dir() and not p.is_symlink():
                continue
            p.unlink()
        p.symlink_to(target)
    (q / "theme.conf").write_text(
        f"[General]\nbackground={media[0]}\ntype={kind}\n"
        f"bg={c['bg_alt']}\naccent={c['accent']}\nalert={c['alert']}\n"
        + "".join(f"{k}={L[k]}\n" for k in ("accent_dim", "accent_glow", "silver", "ghost", "panel", "panel_light", "white",
                                            "shade", "tagline", "failtext", "footer", "product"))
        # any other [lock] keys (e.g. ink, serif for the "novel" layout) pass through as-is
        + "".join(f"{k}={v}\n" for k, v in L.items() if k not in ("accent_dim", "accent_glow", "silver", "ghost", "panel",
                  "panel_light", "white", "shade", "tagline", "failtext", "footer", "product", "lock_layout")), encoding="utf-8")
    (q / "metadata.desktop").write_text(f"[SddmGreeterTheme]\nName={name}\nDescription={m['name']} lock theme\nType=sddm-theme\nVersion=1.0\nMainScript=Main.qml\nConfigFile=theme.conf\n")

def fastfetch(name):
    """fastfetch has no include: write a coloured copy of config.jsonc to gen/ (the shell alias uses it).
    Older setups without the alias get the colours edited in place, as before."""
    p = HOME / ".config/fastfetch/config.jsonc"
    if not p.exists():
        return
    c = load(name)["colors"]; s = p.read_text(encoding="utf-8")
    for key, col in (('"1"', c["border_a"]), ('"2"', c["border_b"]), ('"keys"', c["border_a"]),
                     ('"title"', c["border_b"]), ('"separator"', c["border_a"])):
        s = re.sub(rf'({key}:\s*")#[0-9a-fA-F]{{6}}', rf"\g<1>{col}", s)
    rc = (HOME / ".zshrc").read_text(encoding="utf-8") if (HOME / ".zshrc").exists() else ""
    out = THEMES / name / "gen/fastfetch.jsonc" if "gen/fastfetch.jsonc" in rc else p
    out.write_text(s, encoding="utf-8")

def waybar(name):
    """Render ~/.config/waybar/theme.jsonc.in to gen/waybar.jsonc (included by config.jsonc).
    Older setups without the template get config.jsonc edited in place, as before."""
    t = load(name); c = t["colors"]; icon = t["meta"]["workspace_empty_icon"]
    roles = {"months": c["accent"], "weekdays": c["accent"], "days": c["text"], "weeks": c["text_dim"], "today": c["alert"]}
    tpl = HOME / ".config/waybar/theme.jsonc.in"
    if tpl.exists():
        s = tpl.read_text(encoding="utf-8")
        for k, v in {**roles, "secondary": c["secondary"], "empty_icon": icon}.items():
            s = s.replace(f"@{k}@", v)
        (THEMES / name / "gen/waybar.jsonc").write_text(s, encoding="utf-8")
        return
    p = HOME / ".config/waybar/config.jsonc"
    s = p.read_text(encoding="utf-8")
    for key, col in roles.items():
        s = re.sub(rf'("{key}":\s*"<span color=\')#[0-9a-fA-F]{{6}}', rf"\g<1>{col}", s)
    s = re.sub(r"(<span color=')#[0-9a-fA-F]{6}('>Scroll: month)", rf"\g<1>{c['secondary']}\g<2>", s)
    s = re.sub(r'("empty":\s*").*?(",?\s*\n)', lambda mo: mo.group(1) + icon + mo.group(2), s, count=1)
    p.write_text(s, encoding="utf-8")

if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit("usage: theme-gen NAME")
    gen(sys.argv[1]); waybar(sys.argv[1]); fastfetch(sys.argv[1])
    print(f"theme-gen: {sys.argv[1]} generated")
