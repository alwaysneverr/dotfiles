{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "height": 34,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,

    // Added "memory" right after wireplumber
    "modules-left": ["hyprland/workspaces", "custom/media"],
    "modules-center": ["clock#time"],
    "modules-right": ["memory", "group/status", "clock#date", "custom/notifications"],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{icon}{windows}",
        "format-window-separator": "  ",
        "window-rewrite-default": "󰣆",
        "window-rewrite": {
            "class<kitty>": "󰆍",
            "class<firefox>": "󰈹",
            "class<org.kde.dolphin>": "󰉋",
            "class<vesktop>": "󰙯",
            "class<steam>": "󰓓",
            "class<net.lutris.Lutris>": "󰊗",
            "class<umu-default>": "󰂺",
            "class<.*\\.exe>": "󰂺",
            "class<Vita3K>": "󰊴",
            "class<mpv>": "󰕼",
            "class<imv>": "󰋩",
            "class<geany>": "󰷈",
            "class<org.pulseaudio.pavucontrol>": "󰕾",
            "class<syncplay>": "󰐊",
            "class<parsecd>": "󰢹",
            "class<org.remmina.Remmina>": "󰢹",
            "class<akyuu>": "󰓎",
            "class<zenity>": "󰃭",
            "class<nmtui-float>": "󰤨",
            "class<blueman-manager>": "󰂯"
        },
        "format-icons": {
            "empty": "󰮠",
            "default": ""
        }
    },

    // NEW: Automated Background Music / Playerctl Metadata Module Wrapper
    "custom/media": {
        "format": "󰎇  {}",
        "escape": true,
        "return-type": "json",
        "max-length": 40,
        "on-click": "playerctl play-pause",
        "exec": "playerctl -a metadata --format '{\"text\": \"{{artist}} - {{title}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F"
    },
    

    "backlight": {
        "device": "amd_backlight",
        "format": "{icon}",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Brightness {percent}%"
    },

    "wireplumber": {
        "format": "{icon}",
        "tooltip-format": "Volume {volume}%\n{node_name}",
        "format-icons": ["", "", ""],
        "format-muted": "󰖁",
        "on-click": "uwsm app -- pavucontrol"
    },

    "memory": {
        "interval": 10,
        "format": "󰍛 {percentage}%",
        "tooltip-format": "RAM   {used:0.1f}G / {total:0.1f}G  ({percentage}%)\nSwap  {swapUsed:0.1f}G / {swapTotal:0.1f}G"
    },


    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈁",
        "format-linked": "󰈁",
        "format-disconnected": "󰖪",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}\nLeft: networks   Right: nmtui",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}",
        "tooltip-format-disconnected": "Not connected\nLeft: networks   Right: nmtui",
        "on-click": "$HOME/.local/bin/wifi-menu",
        "on-click-right": "kitty --class nmtui-float -o initial_window_width=80c -o initial_window_height=26c -o remember_window_size=no -e nmtui"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon}",
        "format-charging": "{icon}",
        "format-icons": {"default": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"], "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]},
        "tooltip-format": "{capacity}%  {timeTo}"
    },

    "custom/notifications": {
        "exec": "$HOME/.local/bin/notif-status",
        "return-type": "json",
        "interval": 2,
        "on-click": "$HOME/.local/bin/notif-center",
        "on-click-right": "dunstctl set-paused toggle"
    },

    "group/status": {
        "orientation": "horizontal",
        "modules": ["backlight", "wireplumber", "network", "battery", "tray"]
    },

    "tray": {
    	"icon-size": 16,
    	"spacing": 10
    },


    "clock#time": {
        "format": "󰥔  {:%H:%M}",
        "tooltip": false
    },

    "clock#date": {
        "format": "󰃭 {:%a %d %b}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>\n<span color='#a8dedc'>Scroll: month   Click: year view   Middle: today   Right: pin</span>",
        "on-click-right": "zenity --calendar --title=Calendar",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "first-day-of-week": 1,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#f4a261'><b>{}</b></span>",
                "weekdays": "<span color='#f4a261'>{}</span>",
                "days":     "<span color='#e0e1dd'>{}</span>",
                "weeks":    "<span color='#6c757d'><b>W{}</b></span>",
                "today":    "<span color='#d62828'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click": "mode",
            "on-click-middle": "shift_reset",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    }
}
