[global]
    ### --- actions ---

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all

    ### --- Structural Layout System ---
    monitor = 0
    follow = mouse
    width = 320
    height = (0, 250)
    origin = top-right
    offset = (15, 15)
    scale = 0
    notification_limit = 5

    ### --- Typography Matching ---
    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false

    ### --- Geometry & Border System ---
    corner_radius = 12
    # FIX: Replaced legacy stroke_width and deprecated [frame] section with modern key name
    frame_width = 2
    
    ### --- Progress Bar Sizing ---
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    ### --- Operational Interface State Rules ---
    show_indicators = yes
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/hyprlauncher -m
    browser = /usr/bin/firefox -new-tab
    always_run_script = true
    title = Dunst
    class = Dunst

### --- System Event Priority Color Palettes ---

[urgency_low]
    background = "#121326D9"
    foreground = "#A8DEDC"
    frame_color = "#1E202E"
    timeout = 4

[urgency_normal]
    background = "#121326D9"
    foreground = "#FFFFFF"
    frame_color = "#F4A261"
    highlight = "#F4A261"
    timeout = 8

[urgency_critical]
    background = "#121326E6"
    foreground = "#FFFFFF"
    frame_color = "#D62828"
    highlight = "#D62828"
    timeout = 0
